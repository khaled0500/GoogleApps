rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.projectName is string && data.projectName.size() >= 1 && data.projectName.size() <= 100 &&
             data.shiftStartHour is int && data.shiftStartHour >= 0 && data.shiftStartHour <= 23 &&
             data.shiftStartMinute is int && data.shiftStartMinute >= 0 && data.shiftStartMinute <= 59 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWorker(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80 &&
             data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 60 &&
             data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 80 &&
             data.badgeCode is string && data.badgeCode.size() >= 1 && data.badgeCode.size() <= 24 &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 24)) &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAttendanceStatus(status) {
      return status in ['PRESENT', 'LATE', 'EXCUSED', 'ABSENT'];
    }

    function isValidProofMethod(method) {
      return method in ['GPS_VERIFIED', 'SUPERVISOR_LOG', 'PHOTO_ATTACHED'];
    }

    function isValidAttendanceRecord(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             isValidId(data.workerId) &&
             data.workerName is string && data.workerName.size() >= 2 && data.workerName.size() <= 80 &&
             data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 60 &&
             data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 80 &&
             data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.status is string && isValidAttendanceStatus(data.status) &&
             data.checkInTimeLabel is string && data.checkInTimeLabel.size() <= 24 &&
             (!('checkOutTimeLabel' in data) || (data.checkOutTimeLabel is string && data.checkOutTimeLabel.size() <= 24)) &&
             data.proofMethod is string && isValidProofMethod(data.proofMethod) &&
             (!('locationSummary' in data) || (data.locationSummary is string && data.locationSummary.size() <= 160)) &&
             (!('photoUriString' in data) || (data.photoUriString is string && data.photoUriString.size() <= 400)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             (!('checkInTimestamp' in data) || (data.checkInTimestamp is timestamp && data.checkInTimestamp <= request.time)) &&
             (!('checkOutTimestamp' in data) || (data.checkOutTimestamp is timestamp && data.checkOutTimestamp <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'projectName', 'shiftStartHour', 'shiftStartMinute', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'projectName', 'shiftStartHour', 'shiftStartMinute', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'projectName', 'shiftStartHour', 'shiftStartMinute', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /workers/{workerId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(workerId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(workerId) &&
                         incoming().keys().hasAll(['userId', 'fullName', 'roleTitle', 'siteName', 'badgeCode', 'active', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'fullName', 'roleTitle', 'siteName', 'badgeCode', 'phoneNumber', 'active', 'createdAt', 'updatedAt']) &&
                         isValidWorker(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(workerId) &&
                         isValidWorker(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'roleTitle', 'siteName', 'badgeCode', 'phoneNumber', 'active', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(workerId);
      }

      match /attendance_records/{recordId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(recordId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(recordId) &&
                         incoming().keys().hasAll(['userId', 'workerId', 'workerName', 'roleTitle', 'siteName', 'dateKey', 'status', 'checkInTimeLabel', 'proofMethod', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'workerId', 'workerName', 'roleTitle', 'siteName', 'dateKey', 'status', 'checkInTimeLabel', 'checkOutTimeLabel', 'proofMethod', 'locationSummary', 'photoUriString', 'notes', 'checkInTimestamp', 'checkOutTimestamp', 'createdAt', 'updatedAt']) &&
                         isValidAttendanceRecord(incoming()) &&
                         exists(/databases/$(database)/documents/users/$(userId)/workers/$(incoming().workerId));

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(recordId) &&
                         isValidAttendanceRecord(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().workerId == existing().workerId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['checkOutTimeLabel', 'checkOutTimestamp', 'notes', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'checkInTimeLabel', 'checkOutTimeLabel', 'proofMethod', 'locationSummary', 'photoUriString', 'notes', 'checkInTimestamp', 'checkOutTimestamp', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(recordId);
      }
    }
  }
}
